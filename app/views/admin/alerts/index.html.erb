<% content_for(:title, "Alerts") %>

<div class="space-y-4">
  <h1 class="text-2xl font-bold">Alerts</h1>

  <% if @alerts.any? %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b text-left text-warm-gray">
          <th class="p-3">Time</th>
          <th class="p-3">Type</th>
          <th class="p-3">Severity</th>
          <th class="p-3">Status</th>
          <th class="p-3">Message</th>
          <th class="p-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @alerts.each do |alert| %>
          <tr class="border-b">
            <td class="p-3 text-warm-gray"><%= alert.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="p-3 font-medium"><%= alert.alert_type %></td>
            <td class="p-3">
              <span class="px-2 py-1 rounded-full text-xs
                <% case alert.severity %>
                <% when 'critical' %> bg-blush/50
                <% when 'high' %> bg-sand/50
                <% when 'medium' %> bg-sky/30
                <% else %> bg-light-gray
                <% end %>"><%= alert.severity %></span>
            </td>
            <td class="p-3"><%= alert.status %></td>
            <td class="p-3"><%= truncate(alert.message, length: 50) %></td>
            <td class="p-3"><%= link_to "View", admin_alert_path(alert), class: "text-sky underline" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-warm-gray py-8 text-center">No alerts.</p>
  <% end %>
</div>
