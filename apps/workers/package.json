{
  "name": "@personality/workers",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:prod": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "d1:create:prod": "wrangler d1 create personality-d1-prod",
    "d1:create:staging": "wrangler d1 create personality-d1-staging",
    "secrets:list:prod": "wrangler secret list --env production",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply personality-d1-prod --local"
  },
  "dependencies": {
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.7.0",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.28.0",
    "js-yaml": "^4.1.1",
    "miniflare": "^3.20240909.0",
    "typescript": "^5.6.0",
    "vitest": "3.0.5",
    "wrangler": "^3.90.0"
  }
}
