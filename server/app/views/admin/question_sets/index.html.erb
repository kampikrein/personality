<% content_for(:title, "Question Sets") %>

<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">Question Sets</h1>
    <%= link_to "New Set", new_admin_question_set_path, class: "px-4 py-2 bg-charcoal text-cream rounded-lg text-sm" %>
  </div>

  <table class="w-full text-sm">
    <thead>
      <tr class="border-b text-left text-warm-gray">
        <th class="p-3">Version</th>
        <th class="p-3">Status</th>
        <th class="p-3">Questions</th>
        <th class="p-3">Created</th>
        <th class="p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% @question_sets.each do |qs| %>
        <tr class="border-b">
          <td class="p-3 font-medium"><%= qs.version_code %></td>
          <td class="p-3"><span class="px-2 py-1 rounded-full text-xs bg-<%= qs.status == 'active' ? 'sage' : 'light-gray' %>/30"><%= qs.status %></span></td>
          <td class="p-3"><%= qs.questions.count %></td>
          <td class="p-3"><%= qs.created_at.strftime("%Y-%m-%d") %></td>
          <td class="p-3"><%= link_to "View", admin_question_set_path(qs), class: "text-sky underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
