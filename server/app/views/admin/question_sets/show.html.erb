<% content_for(:title, "Question Set: #{@question_set.version_code}") %>

<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold"><%= @question_set.version_code %></h1>
    <div class="flex space-x-2">
      <%= link_to "Edit", edit_admin_question_set_path(@question_set), class: "px-4 py-2 bg-charcoal text-cream rounded-lg text-sm" %>
      <%= link_to "Back", admin_question_sets_path, class: "px-4 py-2 bg-light-gray rounded-lg text-sm" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="bg-white rounded-xl p-4 shadow-sm">
      <p class="text-sm text-warm-gray">Status</p>
      <p class="font-medium"><%= @question_set.status %></p>
    </div>
    <div class="bg-white rounded-xl p-4 shadow-sm">
      <p class="text-sm text-warm-gray">Questions</p>
      <p class="font-medium"><%= @question_set.questions.count %></p>
    </div>
  </div>

  <div class="bg-white rounded-xl p-6 shadow-sm">
    <h2 class="text-lg font-bold mb-4">Questions</h2>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b text-left text-warm-gray">
          <th class="p-2">#</th>
          <th class="p-2">Domain</th>
          <th class="p-2">Body</th>
          <th class="p-2">Polarity</th>
        </tr>
      </thead>
      <tbody>
        <% @question_set.questions.order(:position).each do |q| %>
          <tr class="border-b">
            <td class="p-2"><%= q.position %></td>
            <td class="p-2"><%= q.domain %></td>
            <td class="p-2"><%= truncate(q.body_ko, length: 60) %></td>
            <td class="p-2"><%= q.polarity %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
