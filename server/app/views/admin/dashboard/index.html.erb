<% content_for(:title, "Dashboard") %>

<div class="space-y-6">
  <h1 class="text-2xl font-bold">Admin Dashboard</h1>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl p-6 shadow-sm">
      <p class="text-sm text-warm-gray">Total Assessments</p>
      <p class="text-3xl font-bold"><%= @total_assessments %></p>
    </div>
    <div class="bg-white rounded-xl p-6 shadow-sm">
      <p class="text-sm text-warm-gray">Completed</p>
      <p class="text-3xl font-bold"><%= @completed_assessments %></p>
    </div>
    <div class="bg-white rounded-xl p-6 shadow-sm">
      <p class="text-sm text-warm-gray">Completion Rate</p>
      <p class="text-3xl font-bold"><%= @completion_rate %>%</p>
    </div>
  </div>
</div>
