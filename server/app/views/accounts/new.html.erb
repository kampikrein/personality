<% content_for(:title, "계정 만들기") %>

<div class="max-w-sm mx-auto space-y-8 py-8">
  <div class="text-center space-y-2">
    <h1 class="text-2xl font-bold">계정 만들기</h1>
    <p class="text-warm-gray text-sm">결과를 저장하고 나중에 다시 확인할 수 있어요</p>
  </div>

  <%= form_with model: @user, url: account_path, class: "space-y-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="p-3 bg-blush/30 rounded-lg text-sm">
        <% @user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="space-y-1">
      <%= f.label :email, "이메일", class: "text-sm font-medium" %>
      <%= f.email_field :email, class: "w-full p-3 bg-light-gray rounded-xl border-0 focus:ring-2 focus:ring-lavender outline-none", placeholder: "email@example.com" %>
    </div>

    <div class="space-y-1">
      <%= f.label :display_name, "표시 이름", class: "text-sm font-medium" %>
      <%= f.text_field :display_name, class: "w-full p-3 bg-light-gray rounded-xl border-0 focus:ring-2 focus:ring-lavender outline-none", placeholder: "닉네임" %>
    </div>

    <div class="space-y-1">
      <%= f.label :password, "비밀번호", class: "text-sm font-medium" %>
      <%= f.password_field :password, class: "w-full p-3 bg-light-gray rounded-xl border-0 focus:ring-2 focus:ring-lavender outline-none" %>
    </div>

    <div class="space-y-1">
      <%= f.label :password_confirmation, "비밀번호 확인", class: "text-sm font-medium" %>
      <%= f.password_field :password_confirmation, class: "w-full p-3 bg-light-gray rounded-xl border-0 focus:ring-2 focus:ring-lavender outline-none" %>
    </div>

    <%= f.submit "계정 만들기",
        class: "w-full py-3 bg-charcoal text-cream rounded-xl font-medium
                 hover:bg-charcoal/90 active:scale-[0.98] transition-all cursor-pointer" %>
  <% end %>

  <p class="text-center text-xs text-warm-gray/60">
    계정을 만들면 이전 검사 결과가 계정에 연결됩니다.
  </p>
</div>
