<div class="text-center space-y-6 py-8" data-controller="type-reveal">
  <%# Type code with reveal animation %>
  <div class="space-y-3">
    <div class="flex justify-center space-x-2" data-type-reveal-target="letters">
      <% profile.type_code.chars.each_with_index do |letter, i| %>
        <% colors = ["sage", "sky", "lavender", "sand"] %>
        <span class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20
                     rounded-2xl bg-<%= colors[i] %>/30 text-3xl sm:text-4xl font-bold
                     opacity-0 translate-y-4"
              data-type-reveal-target="letter"
              style="animation: revealLetter 0.5s ease-out forwards; animation-delay: <%= i * 0.15 %>s;">
          <%= letter %>
        </span>
      <% end %>
    </div>

    <%# Character name %>
    <div class="opacity-0" style="animation: fadeIn 0.6s ease-out forwards; animation-delay: 0.8s;">
      <h1 class="text-2xl sm:text-3xl font-bold"><%= profile.character_name_ko %></h1>
      <p class="text-warm-gray text-sm mt-1"><%= profile.character_name_en %></p>
    </div>
  </div>

  <%# Summary %>
  <div class="opacity-0" style="animation: fadeIn 0.6s ease-out forwards; animation-delay: 1.1s;">
    <p class="text-warm-gray leading-relaxed max-w-md mx-auto">
      <%= profile.summary_ko %>
    </p>
  </div>
</div>

<style>
  @keyframes revealLetter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
</style>
