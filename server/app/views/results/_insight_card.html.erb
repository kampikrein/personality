<div class="bg-white/50 rounded-2xl p-6 space-y-4 border border-light-gray">
  <% if insight.suggestions.present? %>
    <ul class="space-y-3">
      <% insight.suggestions.each do |suggestion| %>
        <li class="flex items-start space-x-3">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-lavender mt-2 shrink-0"></span>
          <span class="text-sm leading-relaxed"><%= suggestion %></span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if insight.explanation.present? %>
    <details class="group">
      <summary class="text-sm text-warm-gray cursor-pointer hover:text-charcoal transition-colors flex items-center space-x-1">
        <span>왜 이 제안이 나왔을까?</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </summary>
      <p class="mt-3 text-sm text-warm-gray leading-relaxed pl-4 border-l-2 border-lavender/30">
        <%= insight.explanation %>
      </p>
    </details>
  <% end %>
</div>
