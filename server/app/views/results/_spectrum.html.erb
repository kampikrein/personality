<%
  domains = [
    { key: "energy", label_low: "내향 (I)", label_high: "외향 (E)", color: "sage" },
    { key: "decision_making", label_low: "감각 (S)", label_high: "직관 (N)", color: "sky" },
    { key: "relationship", label_low: "사고 (T)", label_high: "감정 (F)", color: "lavender" },
    { key: "recovery", label_low: "판단 (J)", label_high: "인식 (P)", color: "sand" }
  ]
%>

<div class="space-y-5" data-controller="spectrum-bar">
  <h2 class="text-xl font-bold">성격 스펙트럼</h2>

  <% domains.each_with_index do |d, i| %>
    <% score = profile.domain_score(d[:key]) %>
    <div class="space-y-1 opacity-0"
         style="animation: fadeIn 0.5s ease-out forwards; animation-delay: <%= 1.4 + (i * 0.2) %>s;"
         data-spectrum-bar-target="domain">
      <div class="flex justify-between text-sm">
        <span class="text-warm-gray"><%= d[:label_low] %></span>
        <span class="font-medium"><%= score.round %>%</span>
        <span class="text-warm-gray"><%= d[:label_high] %></span>
      </div>
      <div class="relative w-full h-3 bg-light-gray rounded-full overflow-hidden">
        <div class="absolute left-1/2 top-0 w-px h-full bg-warm-gray/20"></div>
        <div class="h-full bg-<%= d[:color] %> rounded-full transition-all duration-1000 ease-out"
             style="width: 0%;"
             data-spectrum-bar-target="bar"
             data-final-width="<%= score %>">
        </div>
      </div>
    </div>
  <% end %>
</div>
